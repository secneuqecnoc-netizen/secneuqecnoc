---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";

const posts = await getCollection("blog");

const sortedPosts = posts
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDatetime).getTime();
    const dateB = new Date(b.data.pubDatetime).getTime();
    return dateB - dateA;
  })
  .slice(0, 5);
---

<Layout>
  <main>

    <!-- Ghost -->
    <div class="ghost-container" aria-hidden="true">
      <svg
        class="ghost"
        viewBox="0 0 200 200"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Body -->
        <path
          d="
            M38 125
            C25 108 22 82 30 61
            C40 36 64 22 96 22
            C132 22 158 42 166 70
            C174 98 164 124 151 139

            C145 146 137 149 130 151

            C126 152 124 148 124 143
            C124 138 121 134 118 135
            C113 137 111 146 107 153

            C103 161 96 166 89 166
            C80 166 76 159 75 151
            C74 145 72 139 68 140
            C64 141 61 149 57 153

            C51 159 44 158 40 151
            C35 143 35 134 38 125
            Z
          "
          fill="white"
          stroke="black"
          stroke-width="5"
          stroke-linejoin="round"
        />

        <!-- Left eye -->
        <ellipse
          cx="75"
          cy="76"
          rx="9"
          ry="14"
          fill="black"
        />

        <!-- Right eye -->
        <ellipse
          cx="119"
          cy="76"
          rx="9"
          ry="14"
          fill="black"
        />

        <!-- Left cheek/body line -->
        <path
          d="M65 105 C62 117 58 125 52 132"
          fill="none"
          stroke="black"
          stroke-width="5"
          stroke-linecap="round"
        />

        <!-- Right cheek/body line -->
        <path
          d="M133 105 C131 117 128 126 122 133"
          fill="none"
          stroke="black"
          stroke-width="5"
          stroke-linecap="round"
        />
      </svg>
    </div>


    <!-- Recent Posts -->
    <section class="recent-posts">

      <h2>Recent Posts</h2>

      {
        sortedPosts.length > 0 ? (
          <div class="post-list">
            {sortedPosts.map((post) => (
              <article class="post">
                <a href={`/posts/${post.slug}/`} class="post-link">
                  <h3>{post.data.title}</h3>

                  <div class="post-date">
                    <span class="calendar">▣</span>

                    <time datetime={post.data.pubDatetime.toISOString()}>
                      {post.data.pubDatetime.toLocaleDateString("en-US", {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </time>
                  </div>

                  {post.data.description && (
                    <p>{post.data.description}</p>
                  )}
                </a>
              </article>
            ))}
          </div>
        ) : (
          <p class="no-posts">No posts yet.</p>
        )
      }

      <a href="/posts/" class="all-posts">
        <span>All Posts</span>
        <span class="arrow">→</span>
      </a>

    </section>

  </main>


  <style>
    main {
      position: relative;
      overflow: hidden;
    }


    /* =========================
       GHOST
       ========================= */

    .ghost-container {
      position: fixed;
      left: -220px;
      top: 35%;
      width: 150px;
      height: 150px;

      z-index: 50;

      pointer-events: none;

      animation:
        ghost-fly 13s linear infinite;
    }

    .ghost {
      width: 150px;
      height: 150px;

      display: block;

      animation:
        ghost-float 2.2s ease-in-out infinite;
    }


    /* حرکت روح از چپ به راست */

    @keyframes ghost-fly {
      0% {
        transform: translateX(0);
      }

      100% {
        transform: translateX(calc(100vw + 440px));
      }
    }


    /* بالا و پایین رفتن روح */

    @keyframes ghost-float {
      0% {
        transform: translateY(0) rotate(-2deg);
      }

      25% {
        transform: translateY(-13px) rotate(2deg);
      }

      50% {
        transform: translateY(0) rotate(-1deg);
      }

      75% {
        transform: translateY(13px) rotate(2deg);
      }

      100% {
        transform: translateY(0) rotate(-2deg);
      }
    }


    /* =========================
       POSTS
       ========================= */

    .recent-posts {
      margin-top: 4rem;
      padding: 0 1rem 5rem;
    }

    .recent-posts h2 {
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 3rem;
    }


    .post-list {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }


    .post {
      margin: 0;
      padding: 0;
    }


    .post-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }


    .post h3 {
      margin: 0 0 0.8rem;

      font-size: 1.5rem;
      font-weight: 600;

      color: #0877a9;

      transition:
        color 0.2s ease,
        transform 0.2s ease;
    }


    .post-link:hover h3 {
      color: #055b82;
      transform: translateX(3px);
    }


    .post-date {
      display: flex;
      align-items: center;
      gap: 0.7rem;

      margin-bottom: 0.8rem;

      font-size: 0.95rem;

      opacity: 0.75;
    }


    .calendar {
      font-size: 1.2rem;
    }


    .post p {
      margin: 0;

      font-size: 1rem;
      line-height: 1.7;

      opacity: 0.85;
    }


    .no-posts {
      opacity: 0.6;
    }


    /* =========================
       ALL POSTS
       ========================= */

    .all-posts {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;

      margin-top: 4rem;

      font-size: 1.4rem;

      text-decoration: none;

      color: inherit;

      transition:
        gap 0.2s ease,
        transform 0.2s ease;
    }


    .all-posts:hover {
      gap: 1.4rem;
    }


    .arrow {
      font-size: 2rem;
      line-height: 1;
    }


    /* =========================
       MOBILE
       ========================= */

    @media (max-width: 640px) {

      .ghost-container {
        width: 105px;
        height: 105px;

        left: -150px;

        top: 30%;
      }

      .ghost {
        width: 105px;
        height: 105px;
      }


      .recent-posts {
        margin-top: 3rem;
      }


      .recent-posts h2 {
        font-size: 1.8rem;
      }


      .post h3 {
        font-size: 1.3rem;
      }


      .all-posts {
        font-size: 1.2rem;
      }
    }


    /* =========================
       REDUCE MOTION
       ========================= */

    @media (prefers-reduced-motion: reduce) {

      .ghost-container,
      .ghost {
        animation: none;
      }

    }
  </style>
</Layout>
